# Copy this file to backend/.env and fill in your key.
# (Loaded via python-dotenv from the backend's working directory — see
# claude_client.py, briefing.py, memory.py.)

# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Controls how much of each reply is spoken aloud (the panel
# always shows the full text regardless):
#   brief  (default) — speak only the short headline, read the rest
#   full   — speak the entire reply
#   muted  — speak nothing, text only
SPARK_VOICE_MODE=brief

# Optional. Case-insensitive substring match against input device names
# (see `system_profiler SPAudioDataType` or System Settings > Sound > Input
# to see yours). Only needed if you have multiple mics and the system
# default isn't the one Spark should use — it otherwise auto-detects
# whatever macOS currently considers the default input device.
SPARK_MIC_DEVICE_NAME=

# Optional. Your name (and anything else Whisper tends to mishear for you —
# comma-separated). Biases transcription toward correctly recognizing
# proper nouns, which general-purpose Whisper models otherwise consistently
# mishear since they're underrepresented in training data.
SPARK_VOCAB_PROMPT=
