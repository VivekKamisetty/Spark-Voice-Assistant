# Copy this file to backend/.env and fill in your key.
# (Loaded via python-dotenv from the backend's working directory — see
# claude_client.py, briefing.py, memory.py.)

# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Controls how much of each reply is spoken aloud (the panel
# always shows the full text regardless):
#   brief  (default) — speak only the short headline, read the rest
#   full   — speak the entire reply
#   muted  — speak nothing, text only
SPARK_VOICE_MODE=brief
